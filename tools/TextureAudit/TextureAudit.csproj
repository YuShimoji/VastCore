<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unity を起動せずに、プロジェクトの画像の取り込み設定・出所の記録・寸法を docs/02_design/texture-rules.json と照らす検査。
    検査の本体は Assets/Scripts/TexturePipeline/Editor/Shared のソースをそのままコンパイルする（Unity の Editor と同じコード）。
    LangVersion は Unity と同じ 9.0 に固定する。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="SelfTest.cs" />
    <Compile Include="..\..\Assets\Scripts\TexturePipeline\Editor\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>

</Project>
