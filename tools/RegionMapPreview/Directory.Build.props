<Project>
  <!-- ビルドの出力と中間ファイルは、git 管理外の artifacts/ へ出す（SDK の読み込み前に決める必要がある） -->
  <PropertyGroup>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\region-map-preview\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\region-map-preview\obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
