<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unity を起動せずに地域生成と鳥瞰図の描画を確かめるコンソール。
    Assets/Scripts/RegionMap/Core のソースをそのままコンパイルする（複製しない）。
    LangVersion は Unity と同じ 9.0 に固定する。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="PngWriter.cs" />
    <Compile Include="TerrainMeasurements.cs" />
    <Compile Include="WeatherPreview.cs" />
    <Compile Include="TerrainView.cs" />
    <Compile Include="CoastSurvey.cs" />
    <Compile Include="RouteView.cs" />
    <Compile Include="LookView.cs" />
    <Compile Include="..\..\Assets\Scripts\RegionMap\Core\**\*.cs" LinkBase="Core" />
  </ItemGroup>

</Project>
